<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Demo Web Shop - Complete Test Automation Suite" 
       verbose="2" 
       thread-count="1" 
       parallel="false"
       preserve-order="true">

    <listeners>
        <listener class-name="com.automation.listeners.TerminalSummaryListener"/>
    </listeners>

    <!-- Global Parameters -->
    <parameter name="browser" value="chrome"/>
    <parameter name="appUrl" value="https://demowebshop.tricentis.com/"/>
    <parameter name="implicitWait" value="10"/>
    <parameter name="explicitWait" value="15"/>
    <parameter name="pageLoadTimeout" value="30"/>

    <!-- ======================================================================================== -->
    <!-- TEST GROUP 0: USER STORY RISK-BASED COVERAGE                                           -->
    <!-- ======================================================================================== -->
    <test name="User Story Order Placement Tests" enabled="true">
        <parameter name="testCategory" value="UserStory"/>
        <classes>
            <class name="com.automation.tests.UserStoryOrderPlacementTest">
                <methods>
                    <include name="testCriticalCustomerCanPlaceOrder"/>
                    <include name="testUserStoryKeyUiElementsArePresent"/>
                    <include name="testCheckoutRequiresBillingDetails"/>
                    <include name="testProductDiscoveryResponseTime"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ======================================================================================== -->
    <!-- TEST GROUP 1: USER REGISTRATION (4 Test Cases)                                         -->
    <!-- ======================================================================================== -->
    <test name="Registration Tests" enabled="true">
        <parameter name="testCategory" value="Registration"/>
        <classes>
            <class name="com.automation.tests.RegistrationTest">
                <methods>
                    <include name="testValidUserRegistration"/>
                    <include name="testRegistrationWithExistingEmail"/>
                    <include name="testRegistrationWithMismatchedPasswords"/>
                    <include name="testRegistrationPageElementsValidation"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ======================================================================================== -->
    <!-- TEST GROUP 2: USER LOGIN (5 Test Cases)                                                -->
    <!-- ======================================================================================== -->
    <test name="Login Tests" enabled="true">
        <parameter name="testCategory" value="Login"/>
        <classes>
            <class name="com.automation.tests.LoginTest">
                <methods>
                    <include name="testValidUserLogin"/>
                    <include name="testLoginWithInvalidEmail"/>
                    <include name="testLoginWithInvalidPassword"/>
                    <include name="testLoginAndLogout"/>
                    <include name="testLoginWithRememberMe"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ======================================================================================== -->
    <!-- TEST GROUP 3: PRODUCT SEARCH (5 Test Cases)                                            -->
    <!-- ======================================================================================== -->
    <test name="Product Search Tests" enabled="true">
        <parameter name="testCategory" value="ProductSearch"/>
        <classes>
            <class name="com.automation.tests.ProductSearchTest">
                <methods>
                    <include name="testSearchProductByKeyword"/>
                    <include name="testProductListDisplay"/>
                    <include name="testViewProductDetails"/>
                    <include name="testSearchWithEmptyKeyword"/>
                    <include name="testSearchWithSpecialCharacters"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ======================================================================================== -->
    <!-- TEST GROUP 4: SHOPPING CART (6 Test Cases)                                             -->
    <!-- ======================================================================================== -->
    <test name="Shopping Cart Tests" enabled="true">
        <parameter name="testCategory" value="ShoppingCart"/>
        <classes>
            <class name="com.automation.tests.ShoppingCartTest">
                <methods>
                    <include name="testAddSingleProductToCart"/>
                    <include name="testAddMultipleProductsToCart"/>
                    <include name="testUpdateProductQuantityInCart"/>
                    <include name="testRemoveProductFromCart"/>
                    <include name="testCartTotalCalculation"/>
                    <include name="testEmptyCartValidation"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ======================================================================================== -->
    <!-- TEST GROUP 5: CHECKOUT PROCESS (4 Test Cases)                                          -->
    <!-- ======================================================================================== -->
    <test name="Checkout Tests" enabled="true">
        <parameter name="testCategory" value="Checkout"/>
        <classes>
            <class name="com.automation.tests.CheckoutTest">
                <methods>
                    <include name="testProceedToCheckout"/>
                    <include name="testEnterBillingAddress"/>
                    <include name="testSelectShippingMethod"/>
                    <include name="testSelectPaymentMethod"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ======================================================================================== -->
    <!-- TEST GROUP 6: END-TO-END PURCHASE WORKFLOWS (3 Test Cases)                            -->
    <!-- ======================================================================================== -->
    <test name="End-to-End Purchase Workflow Tests" enabled="true">
        <parameter name="testCategory" value="EndToEndWorkflow"/>
        <classes>
            <class name="com.automation.tests.EndToEndPurchaseWorkflowTest">
                <methods>
                    <include name="testCompleteNewUserPurchaseWorkflow"/>
                    <include name="testCompleteExistingUserPurchaseWorkflow"/>
                    <include name="testMultipleProductsPurchase"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ======================================================================================== -->
    <!-- TOTAL: 27 TEST CASES ACROSS 6 TEST GROUPS                                             -->
    <!-- EXECUTION TIME: ~30-60 minutes (depending on system)                                   -->
    <!-- ======================================================================================== -->

</suite>
